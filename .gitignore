# Xcode
#
# gitignore contributors: remember to update Global/Xcode.gitignore, Objective-C.gitignore & Swift.gitignore

## User settings
xcuserdata/

## compatibility with Xcode 8 and earlier (ignoring not only .xcworkspace but also .xcodeproj)
*.xcscmblueprint
*.xccheckout

## macOS
.DS_Store

## CocoaPods
# We do not use CocoaPods currently, but good practice
Pods/
Podfile.lock

## Carthage
# We do not use Carthage currently, but good practice
Carthage/Build

## SPM (Swift Package Manager)
.build/

## fastlane
# It is recommended to not store the screenshots in the git repo. Instead, use fastlane to re-generate the
# screenshots whenever they are needed.
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

## Docs exclusion
# Ignore everything in docs/
docs/*

## Build Generated files
build/
DerivedData/

## Playgrounds
timeline.xctimeline
playground.xcworkspace

## SwiftLint
.swiftlint

## Crashlytics
com.crashlytics.mac/

## Core Data
*.xcdatamodeld

## App packaging
*.ipa
*.dSYM.zip
*.dSYM
